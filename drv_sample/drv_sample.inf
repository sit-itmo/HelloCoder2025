;
; drv_sample.inf
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System ; TODO: specify appropriate Class
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318} ; TODO: specify appropriate ClassGuid
Provider    = %ManufacturerName%
CatalogFile = drv_sample.cat
DriverVer   = ; TODO: set DriverVer in stampinf property pages
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
drv_sample.sys = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName% = Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%drv_sample.DeviceDesc% = drv_sample_Device, Root\drv_sample ; TODO: edit hw-id

[drv_sample_Device.NT]
CopyFiles = File_Copy

[File_Copy]
drv_sample.sys

;-------------- Service installation
[drv_sample_Device.NT.Services]
AddService = drv_sample,%SPSVCINST_ASSOCSERVICE%, drv_sample_Service_Inst

; -------------- drv_sample driver install sections
[drv_sample_Service_Inst]
DisplayName    = %drv_sample.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\drv_sample.sys

[drv_sample_Device.NT.Wdf]
KmdfService = drv_sample, drv_sample_wdfsect

[drv_sample_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ManufacturerName = "<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "drv_sample Installation Disk"
drv_sample.DeviceDesc = "drv_sample Device"
drv_sample.SVCDESC = "drv_sample Service"
